# 复制这个文件为 .env，然后填写自己的值
# cp .env.example .env   （Windows: copy .env.example .env）

DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]

# 反向 WS 不设 token，本地回环即可
# 要暴露到公网时必须改成强随机串，否则等于把机器人接口裸奔在公网上
ONEBOT_ACCESS_TOKEN=

# ↓↓↓ 必须填，去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 可选 deepseek-chat（能力更强）或 deepseek-flash（更便宜更快）
DEEPSEEK_MODEL=deepseek-chat

# 群聊触发词：除了 @ 机器人，以这个词开头也会回
WHALE_TRIGGER_PREFIX=鲸鱼
# 每次带多少条历史消息（一问一答算 2 条）
WHALE_MAX_HISTORY=10
WHALE_TEMPERATURE=1.1

# 记忆开关。false = 退回内存模式（重启失忆）
WHALE_MEMORY_ENABLED=true

# 允许在群聊使用 /记忆 /忘掉 的 QQ 号，逗号分隔
# 留空 = 群里禁用（防止别人清空群记忆），私聊仍可用
WHALE_ADMIN_QQ=

# 表情包：按回复内容语义检索梗图库
# 需要先跑 python tools/fetch_memes.py 下载图库
WHALE_EMO_ENABLED=true
# 模型没主动标情绪时的发表情概率
WHALE_EMO_PROB=0.35
